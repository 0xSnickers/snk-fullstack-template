NODE_ENV=development
PORT=9000
DATABASE_URL="postgresql://app:password@localhost:5432/nestjs_template?schema=public"
# 允许跨域的前端地址，逗号分隔；走同源代理时可留空
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# 生产环境必须改成 32 位以上随机串：openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
# 启动时创建演示账号 demo@example.com / password123（admin），生产环境关闭
SEED_DEMO_USER=true
LOG_LEVEL=info
LOG_FILE=logs/app.log
