# ---------- 应用信息 ----------
# 应用名称（页面标题、遥测 appName）
VITE_APP_NAME=React App
# 运行环境：development | test | staging | production
VITE_APP_ENV=development
# 版本号（可选，用于 Sentry release），CI 中建议注入 git sha
VITE_APP_RELEASE=

# ---------- 接口 ----------
# 浏览器侧请求前缀。默认走同源 /api，由开发代理或网关转发；也可以直接写完整地址（需后端开启 CORS）
VITE_API_BASE_URL=/api
# 开发代理目标：仅 `npm run dev` 时生效，/api/* 会被转发到这里
VITE_API_PROXY_TARGET=http://localhost:9000/api/v1

# ---------- 遥测（可选） ----------
# 是否启用遥测；true 时按 DSN/Key 初始化 Sentry 和 PostHog
VITE_TELEMETRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
