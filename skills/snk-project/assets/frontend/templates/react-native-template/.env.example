# ---------- 应用信息 ----------
EXPO_PUBLIC_APP_NAME=React Native App
# 运行环境：development | test | staging | production
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_RELEASE=

# ---------- 接口 ----------
# 后端地址。App 运行在手机 / 模拟器上，localhost 指向设备本身：
#   - iOS 模拟器 / Web：http://localhost:9000/api/v1
#   - Android 模拟器：http://10.0.2.2:9000/api/v1
#   - 真机：http://<电脑局域网 IP>:9000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:9000/api/v1
