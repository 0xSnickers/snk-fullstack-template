# ---------- 应用信息（NEXT_PUBLIC_ 前缀会暴露给浏览器） ----------
NEXT_PUBLIC_APP_NAME=Next.js App
# 运行环境：development | test | staging | production
NEXT_PUBLIC_APP_ENV=development

# ---------- 接口（仅服务端可见） ----------
# 后端 API 地址。浏览器只请求同源 /api/*，由 Next.js BFF（src/app/api）转发到这里
API_BASE_URL=http://localhost:9000/api/v1
# 请求后端超时时间（毫秒）
API_TIMEOUT_MS=10000
