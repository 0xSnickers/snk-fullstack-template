# ---------- 应用信息 ----------
VITE_APP_NAME=uni-app App
# 运行环境：development | test | staging | production
VITE_APP_ENV=development
VITE_APP_RELEASE=

# ---------- 接口 ----------
# 后端地址（App / 小程序 / H5 共用，必须是完整地址）。
#   - H5 / iOS 模拟器：http://localhost:9000/api/v1
#   - Android 模拟器：http://10.0.2.2:9000/api/v1
#   - 真机：http://<电脑局域网 IP>:9000/api/v1
# 小程序正式环境要求 HTTPS 且域名需在后台配置。
VITE_API_BASE_URL=http://localhost:9000/api/v1
